# Copy this file to .env (same folder) and fill in your keys.
# .env is gitignored. Real environment variables (for example set with setx) take precedence.

# Required. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Recommended: streaming speech-to-text (Deepgram nova-3). Create a key at https://console.deepgram.com/
# Leave empty to use local faster-whisper instead (install with: .\scripts\setup.ps1 -Whisper).
DEEPGRAM_API_KEY=
